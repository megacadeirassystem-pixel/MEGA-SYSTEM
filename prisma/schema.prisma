generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler (IPv4) — usado em runtime, inclusive serverless
  directUrl = env("DIRECT_URL") // conexão direta — só pra migração/db push
}

// ========================================================================
// CADASTROS — produto vendável e item (matéria-prima / componente comprado)
// ========================================================================

enum TipoItem {
  MATERIA_PRIMA // processada internamente (ex.: chapa MDF, tubo de aço)
  COMPONENTE_COMPRADO // comprado pronto (ex.: pé, parafuso, espuma cortada)
}

model Produto {
  id        String   @id @default(cuid())
  sku       String   @unique
  linha     String // Jerusalém, Longarina, Universitária...
  nome      String
  precoBase Decimal  @db.Decimal(10, 2)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  bom           BomItem[]
  pedidoItens   PedidoItem[]
  ordensProducao OrdemProducao[]

  @@map("produtos")
}

model Item {
  id             String   @id @default(cuid())
  sku            String   @unique
  nome           String
  tipo           TipoItem
  unidadeMedida  String // un, m, m2, kg, l...
  estoqueMinimo  Decimal  @db.Decimal(12, 3) // ponto de reposição
  estoqueAlvo    Decimal  @db.Decimal(12, 3) // até onde repor quando dispara a compra
  leadTimeDias   Int // tempo médio de reposição, em dias
  observacoes    String?  @db.Text
  fornecedorPrincipalId String?
  fornecedorPrincipal   Fornecedor? @relation(fields: [fornecedorPrincipalId], references: [id])
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now())

  estoque          EstoqueItem?
  bomEntradas      BomItem[]
  movimentos       MovimentoEstoque[]
  fornecedorItens  FornecedorItem[]
  pedidoCompraItens PedidoCompraItem[]

  @@map("itens")
}

model Fornecedor {
  id              String   @id @default(cuid())
  nome            String
  contato         String?
  leadTimeMedioDias Int?
  criadoEm        DateTime @default(now())

  itensPrincipais Item[]
  fornecedorItens FornecedorItem[]
  pedidosCompra   PedidoCompra[]
  contasPagar     ContaPagar[]

  @@map("fornecedores")
}

// Um item pode ter mais de um fornecedor possível, com preço/prazo próprios
model FornecedorItem {
  id            String  @id @default(cuid())
  fornecedorId  String
  itemId        String
  precoUnitario Decimal @db.Decimal(10, 4)
  leadTimeDias  Int

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])
  item       Item       @relation(fields: [itemId], references: [id])

  @@unique([fornecedorId, itemId])
  @@map("fornecedor_itens")
}

// ========================================================================
// BOM — a "receita" de cada produto: quais itens e quanto de cada um
// ========================================================================

model BomItem {
  id                  String  @id @default(cuid())
  produtoId           String
  itemId              String
  quantidadePorUnidade Decimal @db.Decimal(12, 4) // quanto desse item 1 unidade do produto consome
  fatorPerda          Decimal @default(1.0) @db.Decimal(5, 3) // 1.05 = 5% de perda esperada (sobra de corte, refugo)

  produto Produto @relation(fields: [produtoId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])

  @@unique([produtoId, itemId])
  @@map("bom_itens")
}

// ========================================================================
// ESTOQUE — saldo atual por item + o livro-razão de cada movimento
// ========================================================================

model EstoqueItem {
  itemId      String  @id
  saldoAtual  Decimal @default(0) @db.Decimal(12, 3) // fisicamente em mãos
  reservado   Decimal @default(0) @db.Decimal(12, 3) // comprometido com pedidos confirmados, ainda não consumido
  atualizadoEm DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id])

  @@map("estoque_itens")
}

enum TipoMovimento {
  ENTRADA_COMPRA // recebimento de um pedido de compra
  RESERVA // pedido confirmado: reserva soft, não sai do saldo físico ainda
  LIBERACAO_RESERVA // produção iniciou/concluiu: a reserva vira saída real (ou é liberada sem uso)
  SAIDA_PRODUCAO // consumo real registrado na produção
  AJUSTE // contagem de inventário, perda não ligada a produção, etc.
  DEVOLUCAO // devolução de cliente ou de produção
}

// O livro-razão: toda alteração de saldo fica registrada aqui, sempre ligada
// à origem (pedido, ordem de produção ou pedido de compra) que a causou —
// é isso que dá rastreabilidade de "o que foi consumido por qual pedido".
model MovimentoEstoque {
  id                  String        @id @default(cuid())
  itemId              String
  tipo                TipoMovimento
  quantidade          Decimal       @db.Decimal(12, 3) // sempre positiva; o "tipo" diz se soma ou subtrai do saldo
  quantidadePlanejada Decimal?      @db.Decimal(12, 3) // só em SAIDA_PRODUCAO: o que a BOM previa, pra medir desperdício
  pedidoId            String?
  ordemProducaoId     String?
  pedidoCompraId      String?
  observacao          String?
  criadoEm            DateTime      @default(now())

  item          Item           @relation(fields: [itemId], references: [id])
  pedido        Pedido?        @relation(fields: [pedidoId], references: [id])
  ordemProducao OrdemProducao? @relation(fields: [ordemProducaoId], references: [id])
  pedidoCompra  PedidoCompra?  @relation(fields: [pedidoCompraId], references: [id])

  @@index([itemId, criadoEm])
  @@map("movimentos_estoque")
}

// ========================================================================
// PEDIDOS — venda confirmada, dispara reserva de material
// ========================================================================

enum StatusPedido {
  ORCAMENTO
  CONFIRMADO // ganhou — já dispara a explosão de BOM e reserva de estoque
  AGUARDANDO_MATERIAL // reserva não cobriu 100% — tem PC em aberto gerado por causa deste pedido
  EM_PRODUCAO
  CONCLUIDO
  CANCELADO
}

model Pedido {
  id        String       @id @default(cuid())
  codigo    String       @unique // MC-0847
  cliente   String
  status    StatusPedido @default(ORCAMENTO)
  criadoEm  DateTime     @default(now())

  itens          PedidoItem[]
  ordensProducao OrdemProducao[]
  movimentos     MovimentoEstoque[]
  pedidosCompra  PedidoCompra[] // PCs gerados por falta de material pra este pedido
  contasReceber  ContaReceber[]
  notasFiscais   NotaFiscal[]

  @@map("pedidos")
}

model PedidoItem {
  id         String  @id @default(cuid())
  pedidoId   String
  produtoId  String
  quantidade Int

  pedido  Pedido  @relation(fields: [pedidoId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("pedido_itens")
}

// ========================================================================
// PRODUÇÃO — onde o consumo planejado vira consumo real
// ========================================================================

enum StatusOrdemProducao {
  PLANEJADA
  EM_PRODUCAO
  AGUARDANDO_MATERIAL
  CONCLUIDA
}

model OrdemProducao {
  id          String              @id @default(cuid())
  codigo      String              @unique // OF-0412
  pedidoId    String
  produtoId   String
  quantidade  Int
  status      StatusOrdemProducao @default(PLANEJADA)
  criadaEm    DateTime            @default(now())
  concluidaEm DateTime?

  pedido     Pedido             @relation(fields: [pedidoId], references: [id])
  produto    Produto            @relation(fields: [produtoId], references: [id])
  movimentos MovimentoEstoque[]

  @@map("ordens_producao")
}

// ========================================================================
// COMPRAS — manual ou sugerido pelo ressuprimento inteligente
// ========================================================================

enum StatusPedidoCompra {
  SUGERIDO // gerado automaticamente pelo motor de ressuprimento, aguarda aprovação
  COTANDO
  EMITIDO
  RECEBIDO_PARCIAL
  RECEBIDO
  ATRASADO
  CANCELADO
}

model PedidoCompra {
  id            String             @id @default(cuid())
  codigo        String             @unique // PC-0233
  fornecedorId  String
  status        StatusPedidoCompra @default(SUGERIDO)
  origemPedidoId String? // se este PC existe por causa de um pedido de venda específico
  criadoEm     DateTime           @default(now())
  previsaoEntrega DateTime?

  fornecedor Fornecedor         @relation(fields: [fornecedorId], references: [id])
  origemPedido Pedido?          @relation(fields: [origemPedidoId], references: [id])
  itens      PedidoCompraItem[]
  movimentos MovimentoEstoque[]

  @@map("pedidos_compra")
}

model PedidoCompraItem {
  id                 String  @id @default(cuid())
  pedidoCompraId     String
  itemId             String
  quantidade         Decimal @db.Decimal(12, 3)
  quantidadeRecebida Decimal @default(0) @db.Decimal(12, 3)
  precoUnitario      Decimal @db.Decimal(10, 4)

  pedidoCompra PedidoCompra @relation(fields: [pedidoCompraId], references: [id])
  item         Item         @relation(fields: [itemId], references: [id])

  @@map("pedido_compra_itens")
}

// ========================================================================
// FINANCEIRO — contas a pagar/receber, plano de contas e conciliação bancária
// ========================================================================

model ContaBancaria {
  id           String   @id @default(cuid())
  nome         String
  banco        String?
  saldoInicial Decimal  @default(0) @db.Decimal(14, 2)
  criadoEm     DateTime @default(now())

  contasPagar   ContaPagar[]
  contasReceber ContaReceber[]
  conciliacoes  ConciliacaoBancaria[]

  @@map("contas_bancarias")
}

enum TipoPlanoContas {
  RECEITA
  DESPESA
}

// Categoria financeira (ex.: "Venda de produto", "Matéria-prima", "Frete") — alimenta o DRE.
model PlanoContas {
  id     String          @id @default(cuid())
  codigo String          @unique
  nome   String
  tipo   TipoPlanoContas

  contasPagar   ContaPagar[]
  contasReceber ContaReceber[]

  @@map("plano_contas")
}

enum StatusTitulo {
  ABERTO
  PARCIAL
  PAGO
  VENCIDO
  CANCELADO
}

model ContaPagar {
  id              String         @id @default(cuid())
  descricao       String
  fornecedorId    String?
  fornecedor      Fornecedor?    @relation(fields: [fornecedorId], references: [id])
  planoContasId   String?
  planoContas     PlanoContas?   @relation(fields: [planoContasId], references: [id])
  contaBancariaId String?
  contaBancaria   ContaBancaria? @relation(fields: [contaBancariaId], references: [id])
  valor           Decimal        @db.Decimal(14, 2)
  valorPago       Decimal        @default(0) @db.Decimal(14, 2)
  vencimento      DateTime
  dataBaixa       DateTime?
  formaPagamento  String?
  // Juros/multa são custo extra além do valor do título, não contam pra quitação;
  // desconto conta como quitação (valorPago + desconto >= valor fecha como PAGO).
  juros           Decimal        @default(0) @db.Decimal(14, 2)
  multa           Decimal        @default(0) @db.Decimal(14, 2)
  desconto        Decimal        @default(0) @db.Decimal(14, 2)
  status          StatusTitulo   @default(ABERTO)
  criadoEm        DateTime       @default(now())

  @@index([status, vencimento])
  @@map("contas_pagar")
}

model ContaReceber {
  id              String         @id @default(cuid())
  descricao       String
  // Texto livre — Mega ainda não tem um cadastro de Cliente próprio (Pedido.cliente também é
  // string); títulos manuais (sem pedido) precisam de um nome pra aparecer na tela mesmo assim.
  clienteNome     String
  pedidoId        String?
  pedido          Pedido?        @relation(fields: [pedidoId], references: [id])
  planoContasId   String?
  planoContas     PlanoContas?   @relation(fields: [planoContasId], references: [id])
  contaBancariaId String?
  contaBancaria   ContaBancaria? @relation(fields: [contaBancariaId], references: [id])
  valor           Decimal        @db.Decimal(14, 2)
  valorPago       Decimal        @default(0) @db.Decimal(14, 2)
  vencimento      DateTime
  dataBaixa       DateTime?
  status          StatusTitulo   @default(ABERTO)
  criadoEm        DateTime       @default(now())

  @@index([status, vencimento])
  @@map("contas_receber")
}

// Resultado de um upload de extrato OFX: cada item é {fitId, data, valor, descricao, status,
// contaPagarId?, contaReceberId?} — guardado como JSON (mesmo padrão simples de Biogreen) em vez
// de uma tabela própria por item, já que o item em si não precisa ser consultado isoladamente.
model ConciliacaoBancaria {
  id              String        @id @default(cuid())
  contaBancariaId String
  contaBancaria   ContaBancaria @relation(fields: [contaBancariaId], references: [id])
  importadoEm     DateTime      @default(now())
  itens           Json

  @@map("conciliacoes_bancarias")
}

// ========================================================================
// FISCAL — emissão de NF-e
// ========================================================================

enum StatusNotaFiscal {
  AUTORIZADA
  CANCELADA
  PENDENTE
}

// Chave de acesso e autorização são simuladas — emitir NF-e de verdade exige certificado
// digital A1/A3 e um provedor (Focus NFe, NFe.io etc.) contratado junto à SEFAZ; isso aqui
// é o controle interno (numeração, status, histórico), não uma integração fiscal real.
model NotaFiscal {
  id                 String           @id @default(cuid())
  numero             Int              @unique
  serie              String           @default("1")
  chaveAcesso        String           @unique
  pedidoId           String?
  pedido             Pedido?          @relation(fields: [pedidoId], references: [id])
  // Texto livre (ex.: "MC-0847") — Comercial/Compras ainda não geram Pedido real no banco,
  // então por enquanto a NF-e referencia o código pelo nome, não por uma FK de verdade.
  referenciaPedido   String?
  clienteNome        String
  valor              Decimal          @db.Decimal(12, 2)
  status             StatusNotaFiscal @default(AUTORIZADA)
  dataEmissao        DateTime         @default(now())
  dataCancelamento   DateTime?
  motivoCancelamento String?

  @@map("notas_fiscais")
}

// ========================================================================
// RH — colaboradores, ponto/escala e comissão de vendedores
// ========================================================================

enum SetorColaborador {
  FABRICA
  COMERCIAL
  LOGISTICA
  ADMINISTRACAO
}

enum StatusColaborador {
  ATIVO
  EXPERIENCIA
  AFASTADO
  DESLIGADO
}

model Colaborador {
  id               String            @id @default(cuid())
  nome             String
  cargo            String
  setor            SetorColaborador
  telefone         String?
  salario          Decimal?          @db.Decimal(10, 2)
  dataAdmissao     DateTime
  dataDesligamento DateTime?
  status           StatusColaborador @default(EXPERIENCIA)
  criadoEm         DateTime          @default(now())

  comissoes Comissao[]
  pontos    RegistroPonto[]

  @@map("colaboradores")
}

// Uma comissão por vendedor/mês — valorComissao é calculado (valorVendido * percentual) na
// criação, mas fica gravado (não recalculado on-the-fly) pra não mudar o histórico se o
// percentual padrão for revisto depois.
model Comissao {
  id            String      @id @default(cuid())
  colaboradorId String
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  mesReferencia DateTime
  valorVendido  Decimal     @db.Decimal(12, 2)
  percentual    Decimal     @db.Decimal(5, 2)
  valorComissao Decimal     @db.Decimal(12, 2)
  pago          Boolean     @default(false)
  dataPagamento DateTime?
  criadoEm      DateTime    @default(now())

  @@unique([colaboradorId, mesReferencia])
  @@map("comissoes")
}

// Resumo mensal, não ponto eletrônico batido no relógio — bate com o que uma tela de RH dentro
// de um ERP de gestão precisa mostrar (dias trabalhados/faltas/horas extras do mês), não com um
// quiosque de marcação física, que é outro produto.
model RegistroPonto {
  id              String      @id @default(cuid())
  colaboradorId   String
  colaborador     Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  mesReferencia   DateTime
  diasTrabalhados Int
  faltas          Int         @default(0)
  horasExtras     Decimal     @default(0) @db.Decimal(6, 2)
  observacao      String?
  criadoEm        DateTime    @default(now())

  @@unique([colaboradorId, mesReferencia])
  @@map("registros_ponto")
}
